<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создать проект" Height="165" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="96"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Название" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,12,0"/>
      <TextBox x:Name="NameBox" Grid.Column="1" Height="30"/>
    </Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="PrimaryButton" Content="Создать" Width="96" Margin="0,0,8,0" Click="create_click"/>
      <Button Content="Отмена" Width="86" Click="cancel_click"/>
    </StackPanel>
  </Grid>
</Window>
