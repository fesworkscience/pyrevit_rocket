<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GIP Vision Result"
        Height="360"
        Width="560"
        WindowStartupLocation="CenterScreen"
        Background="#FFF8FAFC"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="AR-сессия создана" FontSize="20" FontWeight="SemiBold" Foreground="#FF0F3D63" Margin="0,0,0,10"/>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="PIN" VerticalAlignment="Center" Foreground="#FF0F172A" FontWeight="SemiBold"/>
            <TextBox x:Name="txtPin" Grid.Column="1" Height="32" VerticalContentAlignment="Center" FontSize="16" FontWeight="Bold" Padding="10,2" IsReadOnly="True" BorderBrush="#FF0EA5A3"/>
            <Button x:Name="btnCopyPin" Grid.Column="2" Click="btnCopyPin_Click" Content="Копировать" Height="32" Margin="8,0,0,0" Background="#FF0F766E" Foreground="White" BorderBrush="#FF115E59"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Deeplink" VerticalAlignment="Center" Foreground="#FF0F172A"/>
            <TextBox x:Name="txtDeeplink" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="8,2" IsReadOnly="True" BorderBrush="#FF94A3B8"/>
            <Button x:Name="btnCopyDeeplink" Grid.Column="2" Click="btnCopyDeeplink_Click" Content="Копировать" Height="28" Margin="8,0,0,0" Background="#FFE2E8F0" BorderBrush="#FFCBD5E1"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Expires" VerticalAlignment="Center" Foreground="#FF0F172A"/>
            <TextBox x:Name="txtExpires" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="8,2" IsReadOnly="True" BorderBrush="#FF94A3B8"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="IFC" VerticalAlignment="Center" Foreground="#FF0F172A"/>
            <TextBox x:Name="txtIfcPath" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="8,2" IsReadOnly="True" BorderBrush="#FF94A3B8"/>
        </Grid>

        <Border Grid.Row="5" Background="#FFEAF4FF" BorderBrush="#FFBFDBFE" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,4,0,0">
            <TextBlock x:Name="txtResolve" TextWrapping="Wrap" Foreground="#FF0C4A6E"/>
        </Border>

        <Grid Grid.Row="6" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" x:Name="btnClose" Click="btnClose_Click" Content="Закрыть" Height="32" Background="#FFF1F5F9" BorderBrush="#FFCBD5E1"/>
        </Grid>
    </Grid>
</Window>
