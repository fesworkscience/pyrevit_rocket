<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GIP Vision Session"
        Height="455"
        Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7FAFC"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="10" Padding="14" Margin="0,0,0,12" Background="#FF0F3D63">
            <StackPanel>
                <TextBlock Text="GIP Vision AR Session" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="IFC экспорт и отправка в session/by_plane" Foreground="#FFD7E9F7" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="X-API-Key" VerticalAlignment="Center" Foreground="#FF1E293B"/>
                <TextBox x:Name="txtApiKey" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="8,2" BorderBrush="#FF94A3B8"/>
            </Grid>
            <TextBlock Text="* Необязательно для by_plane с model_file" Margin="150,0,0,0" Foreground="#FF475569" FontSize="11"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Папка IFC" VerticalAlignment="Center" Foreground="#FF1E293B"/>
            <TextBox x:Name="txtExportFolder" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="8,2" BorderBrush="#FF94A3B8"/>
            <Button Grid.Column="2" x:Name="btnBrowse" Click="btnBrowse_Click" Content="Обзор" Height="28" Margin="8,0,0,0" Background="#FFE2E8F0" BorderBrush="#FFCBD5E1"/>
        </Grid>

        <StackPanel Grid.Row="3">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Имя файла" VerticalAlignment="Center" Foreground="#FF1E293B"/>
                <TextBox x:Name="txtFilePrefix" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="8,2" BorderBrush="#FF94A3B8"/>
            </Grid>

            <CheckBox x:Name="chkResolve" Content="Проверить код через resolve-by-onetime-code" Foreground="#FF0F172A" Margin="0,0,0,10"/>

            <Border Background="#FFEAF4FF" BorderBrush="#FFBFDBFE" BorderThickness="1" CornerRadius="8" Padding="10">
                <TextBlock TextWrapping="Wrap" Foreground="#FF0C4A6E">
                Будет экспортирован IFC с настройками стандартного IFC экспорта Revit (без кастомной конфигурации), затем отправлен только с полем model_file.
                </TextBlock>
            </Border>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" x:Name="btnCancel" Click="btnCancel_Click" Content="Отмена" Height="32" Margin="0,0,8,0" Background="#FFF1F5F9" BorderBrush="#FFCBD5E1"/>
            <Button Grid.Column="2" x:Name="btnRun" Click="btnRun_Click" Content="Создать" Height="32" Background="#FF0F766E" Foreground="White" BorderBrush="#FF115E59"/>
        </Grid>
    </Grid>
</Window>
