<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Экспорт модели в GIP Vision"
        Height="505"
        Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="GIP Vision: экспорт модели из активного 3D-вида"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <Border Grid.Row="1" BorderThickness="1" Padding="10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Активный вид" FontWeight="SemiBold"/>
                <TextBlock x:Name="txtViewName" Margin="0,4,0,2" TextWrapping="Wrap"/>
                <TextBlock x:Name="txtViewInfo" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Сценарий" VerticalAlignment="Center"/>
            <ComboBox x:Name="cmbScenario" Grid.Column="1" Height="28" SelectedIndex="0">
                <ComboBoxItem Tag="by_plane" Content="Экспорт по плоскости"/>
                <ComboBoxItem Tag="by_refimage" Content="Экспорт по маркеру"/>
                <ComboBoxItem Tag="by_scan" Content="Экспорт по двери"/>
            </ComboBox>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="X-API-Key" VerticalAlignment="Center"/>
                <TextBox x:Name="txtApiKey" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="8,2"/>
            </Grid>
            <CheckBox x:Name="chkResolve" Content="Проверить код через resolve-by-onetime-code"/>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Папка IFC" VerticalAlignment="Center"/>
            <TextBox x:Name="txtExportFolder" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="8,2"/>
            <Button Grid.Column="2" x:Name="btnBrowse" Click="btnBrowse_Click" Content="Обзор" Height="28" Margin="8,0,0,0"/>
        </Grid>

        <Grid Grid.Row="5" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Имя файла" VerticalAlignment="Center"/>
            <TextBox x:Name="txtFilePrefix" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="8,2"/>
        </Grid>

        <Border Grid.Row="6" BorderThickness="1" Padding="10">
            <TextBlock TextWrapping="Wrap">
                Команда экспортирует IFC из активного 3D-вида, отправляет реальный запрос в GIP Vision API и сохраняет JSON трассировки отправленных полей. Для сценария по маркеру после закрытия окна нужно будет указать точку на поверхности элемента. Для сценария по двери после экспорта нужно будет указать грань стены, после чего команда разместит один экземпляр GIP_Vision_Door.rfa и покажет окно подтверждения, пока вы меняете его ширину и высоту.
            </TextBlock>
        </Border>

        <Grid Grid.Row="7" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" x:Name="btnCancel" Click="btnCancel_Click" Content="Отмена" Height="32" Margin="0,0,8,0"/>
            <Button Grid.Column="2" x:Name="btnRun" Click="btnRun_Click" Content="Экспорт" Height="32"/>
        </Grid>
    </Grid>
</Window>
